# Better Stack API Keys
# Get these from: https://betterstack.com -> Settings -> API tokens

# Uptime API - for monitoring website availability
BETTER_STACK_UPTIME_API_KEY=your_uptime_api_key_here

# Telemetry API - for performance metrics
BETTER_STACK_TELEMETRY_API_KEY=your_telemetry_api_key_here

# GitHub Token (optional - for private repos)
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Vercel (triage board: latest deploy per site)
# Create at: https://vercel.com/account/tokens  (read-only scope is enough)
VERCEL_TOKEN=your_vercel_token_here
# Only if your projects live under a team: https://vercel.com/teams -> Settings -> Team ID
VERCEL_TEAM_ID=

# Push alerts (GET /api/cron/alerts, called by .github/workflows/triage-alerts.yml)
# Shared secret the workflow sends as "Authorization: Bearer <value>". Generate: openssl rand -hex 32
CRON_SECRET=
# Postgres connection string (e.g. a Neon database). Used only to remember each site's last alert state.
DATABASE_URL=
# Resend (https://resend.com) for alert emails
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
